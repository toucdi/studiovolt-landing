# SMTP Configuration for Contact Form
# Configure these environment variables to enable email sending

# SMTP server hostname (e.g., smtp.gmail.com, smtp-mail.outlook.com)
SMTP_HOST=smtp.example.com

# SMTP server port (usually 465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# SMTP authentication username (usually your email address)
SMTP_USER=your-email@example.com

# SMTP authentication password or app-specific password
SMTP_PASS=your-smtp-password

# Email address that will receive contact form submissions
# Suggested: sales@studiovolt.it
CONTACT_RECIPIENT=sales@studiovolt.it
